# ─── Dzine.ai API ─────────────────────────────────────────────────────────────
REACT_APP_DZINE_API_KEY=your_dzine_api_key_here

# ─── Peecho V3 API ────────────────────────────────────────────────────────────
# Merchant API key (from Peecho dashboard → Settings → API)
PEECHO_MERCHANT_KEY=your_peecho_merchant_key_here

# Canvas offering ID is hardcoded in createPeechoPublication.mjs:
#   6968193 = 41x51cm / 16x20" Stretched Canvas [Black Wrap]
# To change product: update CANVAS_OFFERING_ID in netlify/functions/createPeechoPublication.mjs

# ─── Cloudinary (image storage) ───────────────────────────────────────────────
# Cloud name from Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here

# Unsigned upload preset name (Cloudinary → Settings → Upload → Upload presets)
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset_here
